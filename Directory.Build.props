<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>en-US</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Product>Aqvenor</Product>
    <Company>Aqvenor</Company>

    <!--
      One version, and it must agree with electron/package.json and with the tag on the release.
      The prerelease suffix identifies the alpha release channel used by the Electron updater.
      See CHANGELOG.md for the scope of each release.
    -->
    <Version>0.3.3-alpha</Version>
    <VersionPrefix>0.3.3</VersionPrefix>
    <AssemblyVersion>0.3.3.0</AssemblyVersion>
    <FileVersion>0.3.3.0</FileVersion>
    <InformationalVersion>0.3.3-alpha</InformationalVersion>
  </PropertyGroup>

</Project>
